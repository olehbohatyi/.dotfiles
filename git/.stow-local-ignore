# Same as GNU Stow's built-in default ignore list, plus .DS_Store.
# A package-local ignore file REPLACES the built-in list entirely (it does
# not merge with it), so the defaults are repeated here on purpose.
# See CLAUDE.md and https://www.gnu.org/software/stow/manual/stow.html

RCS
.+,v

CVS
\.\#.+       # CVS conflict files / emacs lock files
\.cvsignore

\.svn
_darcs
\.hg

\.git
\.gitignore
\.gitmodules

.+~          # emacs backup files
\#.*\#       # emacs autosave files

^/README.*
^/LICENSE.*
^/COPYING

\.DS_Store
